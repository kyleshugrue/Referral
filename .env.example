# Database Configuration
DATABASE_URL=your_database_url_here
PGHOST=your_pg_host_here
PGPORT=your_pg_port_here
PGUSER=your_pg_user_here
PGPASSWORD=your_pg_password_here
PGDATABASE=your_pg_database_here

# Firebase Configuration (Optional - for authentication)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY=your_firebase_private_key

# AI Integration — Worker VM ONLY. Never set this on the main app;
# the main app only queues jobs and must not hold the Anthropic key.
ANTHROPIC_API_KEY=your_anthropic_api_key

# AWS S3 (Optional - for file uploads)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET_NAME=your_s3_bucket_name
AWS_S3_REGION=your_s3_region

# Worker Configuration (DO NOT SET IN MAIN APP)
# RUN_CMDCC_WORKER - DO NOT set this in the main app
# This should ONLY be set to 'true' in the dedicated worker VM
# Setting this in the main app will cause the main app to process jobs
# which defeats the purpose of having a separate worker