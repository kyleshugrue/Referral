# Application environment variables
# Copy the names from .env.example and set local-only values here.
# Never commit this file with real secrets.
NODE_ENV=development
PORT=5000
RATE_LIMIT_MODE=memory
SESSION_COOKIE_SAMESITE=lax
JSON_BODY_LIMIT_BYTES=262144
URLENCODED_BODY_LIMIT_BYTES=131072
INTERNAL_BODY_LIMIT_BYTES=65536
SMOKE_TEST=false
CI=false
