  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && node scripts/generate-release-manifest.mjs",
    "bundle:budget": "node scripts/check-bundle-budget.mjs",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "NODE_OPTIONS=--max-old-space-size=6144 tsc",
    "db:push": "drizzle-kit push",
    "db:migrate:disposable": "node scripts/migrate-disposable-db.mjs",
    "db:verify": "node scripts/verify-migrations.mjs",
    "repo:hygiene": "node scripts/repository-hygiene.mjs",
    "validate:public": "node scripts/validate-public-checkout.mjs",
    "release:manifest": "node scripts/generate-release-manifest.mjs",
    "release:validate": "npm run db:verify && npm run lint && npm run typecheck:gate && npm run test:unit && npm run build && npm run bundle:budget",
    "release:validate:clean": "REQUIRE_CLEAN_TREE=1 npm run release:validate",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=6144 tsc",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:e2e:smoke": "playwright test --config=playwright.config.ts",
    "validate": "npm run release:validate",
    "typecheck:gate": "node scripts/typecheck-gate.mjs"
  },
